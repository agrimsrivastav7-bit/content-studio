# AI Blog Governance Studio - Backend Environment Variables

# ==============================================================================
# LLM Provider Configuration
# Choose one of: openai, anthropic, gemini
# If left blank, the system will auto-detect based on the API keys provided below.
# ==============================================================================
LLM_PROVIDER=openai

# OpenRouter API Key (if using openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: Specify the model, e.g. anthropic/claude-3-opus, google/gemini-1.5-pro, openai/gpt-4o
OPENROUTER_MODEL=anthropic/claude-3-opus

# OpenAI API Key (if using openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (if using gemini)
GOOGLE_API_KEY=your_google_api_key_here

# ==============================================================================
# Database Configuration (For pgvector Retrieval Engine)
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/content_gov
